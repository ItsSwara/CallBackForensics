{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["packages/*/src", "packages/*/test", "packages/demo/**/*.ts", "scripts", "vitest.config.ts"],
  "exclude": ["node_modules"]
}
